# ==============================================================================
# SatQuery AI - Environment Configuration (.env.example)
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ==============================================================================

# Supabase Authentication & PostgreSQL Database
# Retrieve these from your Supabase Project Settings -> API & Auth
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key-here
# Optional: Supabase service role key for admin background tasks (SERVER ONLY - NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# OpenAI API Configuration (Server Only)
# Used for Vision-capable multimodal satellite imagery analysis
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
# Model identifier (defaults to gpt-4o)
OPENAI_MODEL=gpt-4o

# NASA Open APIs
# NASA Image and Video Library is public and requires no key: https://images-api.nasa.gov
# If using NASA Earthdata / GIBS or other NASA APIs requiring a key:
# Sign up free at: https://api.nasa.gov/
NASA_API_KEY=DEMO_KEY

# Optional: Google Maps JavaScript API (for optional satellite basemap layer)
# If provided, enables Google Maps satellite tiles in Map Explorer.
# Leave empty if using standard NASA GIBS, OpenStreetMap, and Esri Satellite.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Application URL for Auth callbacks and redirection
NEXT_PUBLIC_APP_URL=http://localhost:3000
